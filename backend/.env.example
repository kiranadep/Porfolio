# Environment Configuration Example
# Copy this file to .env and insert your real Neon PostgreSQL credentials

SECRET_KEY=django-insecure-replace-with-a-secure-random-key-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Neon PostgreSQL Connection URL
# Replace with your actual Neon connection string:
DATABASE_URL=postgresql://user:password@ep-example-pooler.region.aws.neon.tech/neondb?sslmode=require
